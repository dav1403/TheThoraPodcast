<!--
  A ajouter dans le <dict> racine de ios/App/App/Info.plist
  (apres `npx cap add ios`).
-->

<!--
  Lecture audio quand l'app est en arriere-plan / ecran verrouille.

  /!\ Cette cle NE SUFFIT PAS a elle seule. Il faut AUSSI mettre l'AVAudioSession
  en categorie `playback` au demarrage (voir AppDelegate.audio.swift.txt dans ce
  meme dossier), sinon iOS coupe le son des que l'app passe en arriere-plan ou
  que l'ecran se verrouille.

  /!\ Et Apple REJETTE une app qui declare `audio` sans reellement lire de
  l'audio en arriere-plan. Ne pas poser cette cle "au cas ou".
-->
<key>UIBackgroundModes</key>
<array>
  <string>audio</string>
</array>

<!-- Nom affiche sous l'icone -->
<key>CFBundleDisplayName</key>
<string>Torah Podcast</string>

<!-- Barre de statut claire sur fond sombre -->
<key>UIStatusBarStyle</key>
<string>UIStatusBarStyleLightContent</string>
<key>UIViewControllerBasedStatusBarAppearance</key>
<false/>

<!--
  Le site est charge en HTTPS : aucune exception ATS n'est necessaire.
  N'ajouter NSAllowsArbitraryLoads sous AUCUN pretexte (rejet Apple).
-->
