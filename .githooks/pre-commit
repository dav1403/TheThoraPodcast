#!/bin/bash
# Pre-commit hook: integrity checks + JS syntax validation.

PYTHON=""
for candidate in \
    "/c/Users/David/AppData/Local/Programs/Python/Python311/python.exe" \
    "/c/Users/David/AppData/Local/Programs/Python/Python314/python.exe" \
    "$(which python3 2>/dev/null)" \
    "$(which python 2>/dev/null)"; do
  if [ -x "$candidate" ] 2>/dev/null; then
    PYTHON="$candidate"
    break
  fi
done

if [ -z "$PYTHON" ]; then
  echo "[pre-commit] WARNING: Python introuvable, verification ignoree."
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
"$PYTHON" "$SCRIPT_DIR/pre-commit-check.py"
